   "source": [
    "import pandas as pd\n",
    "\n",
    "transactions_df = pd.read_csv(\"data/transactions.csv\")\n",
    "customers_df = pd.read_csv(\"data/customers.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "89e65cda",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Merge \n",
    "\n",
    "new_table = transactions_df.merge(\n",
    "    customers_df,\n",
    "    on=\"customer_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "print(new_table)"
   ]
  }
